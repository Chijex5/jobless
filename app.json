{
  "expo": {
    "name": "jobless",
    "slug": "jobless",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "jobless",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.chijex5.jobless"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f3ec"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1646ba58-4016-4def-bfec-c2763a0f4dea"
      }
    }
  }
}
